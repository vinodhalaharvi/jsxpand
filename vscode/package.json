{
  "name": "jsxpand",
  "displayName": "jsxpand",
  "description": "Type an abbreviation, get the JSX your own codebase would write: learned from your project, with its imports, hooks and props put in place.",
  "version": "0.3.0",
  "publisher": "vhalaharvi",
  "author": "Vinod Halaharvi",
  "license": "MIT",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#111827",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vinodhalaharvi/jsxpand",
    "directory": "vscode"
  },
  "homepage": "https://github.com/vinodhalaharvi/jsxpand#readme",
  "bugs": {
    "url": "https://github.com/vinodhalaharvi/jsxpand/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Snippets",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "react",
    "jsx",
    "tsx",
    "emmet",
    "abbreviation",
    "shadcn",
    "completion"
  ],
  "activationEvents": [
    "onLanguage:typescriptreact",
    "onLanguage:javascriptreact"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "jsxpand.relearn",
        "title": "jsxpand: Learn this workspace again"
      }
    ],
    "configuration": {
      "title": "jsxpand",
      "properties": {
        "jsxpand.results": {
          "type": "number",
          "default": 3,
          "minimum": 1,
          "maximum": 8,
          "description": "How many readings of an abbreviation to offer."
        },
        "jsxpand.sourceFolder": {
          "type": "string",
          "default": "",
          "description": "Folder to learn from, relative to the workspace. Empty: src/ when there is one, else the whole workspace."
        },
        "jsxpand.suggestNext": {
          "type": "boolean",
          "default": true,
          "description": "On an empty spot inside a component (after typing < or on asking for suggestions), list what your project puts there, best first, with the short form to type for each."
        },
        "jsxpand.hoverMap": {
          "type": "boolean",
          "default": true,
          "description": "Hovering a component's tag shows what goes inside it in your project, two levels down."
        }
      }
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "package": "node build.mjs && npx --yes @vscode/vsce@3 package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.25.12"
  }
}
