  "import { useState } from \"react\";",
  "import useDialogState from \"@/hooks/use-dialog-state\";",
  "import { Task } from \"@/features/tasks/data/schema\";",
  "import { UsersDeleteDialog } from \"@/features/users/components/users-delete-dialog\";",
  "",
  "export function UsersDeleteDialogExample() {",
  "  const [open, setOpen] = useDialogState()",
  "",
  "  const [currentRow, setCurrentRow] = useState<Task | null>(null)",
  "",
  "  return (",
  "    <UsersDeleteDialog open={open === 'delete'} onOpenChange={() => {",
  "              setOpen('delete')",
  "              setTimeout(() => {",
  "                setCurrentRow(null)",
  "              }, 500)",
  "            }} currentRow={currentRow} />",
  "  );",
  "}"
 ],
